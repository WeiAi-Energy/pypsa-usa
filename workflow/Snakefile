# ======================== Sector Configuration ========================
if config["scenario"]["sector"] == "SimpSec":
    pass
elif "E" not in config["scenario"]["sector"]:
    if not config["scenario"]["sector"]:
        config["scenario"]["sector"] = "E"
    else:
        config["scenario"]["sector"] = f"E-{config['scenario']['sector']}"


# ======================== Rule All ========================
def get_all_outputs(wildcards):
    """Generate all required output files across all cases."""
    outputs = []

    # Get default transmission network from global config
    default_transmission_network = config.get("model_topology", {}).get(
        "transmission_network", "tamu"
    )

    for case_name in CASES:
        # Only generate outputs for cases that are defined in config
        if case_name not in config["cases"]:
            continue

        # Get case-specific configuration
        case_config = config["cases"][case_name]

        # Get transmission network for this specific case
        # Use case-specific value if it exists, otherwise use default
        transmission_network = case_config.get("model_topology", {}).get(
            "transmission_network", default_transmission_network
        )

        # Capacity figures
        outputs.extend(
            [
                f"{RESULTS}{transmission_network}/{case_name}/figures/capacity/generation_capacities.png",
                f"{RESULTS}{transmission_network}/{case_name}/figures/capacity/transport_capacities.png",
                f"{RESULTS}{transmission_network}/{case_name}/figures/capacity/storage_energy_capacities.png",
                f"{RESULTS}{transmission_network}/{case_name}/figures/capacity/storage_power_capacities.png",
            ]
        )

        # Dispatch figures
        outputs.extend(
            [
                f"{RESULTS}{transmission_network}/{case_name}/figures/dispatch/electricity_dispatch.png",
                f"{RESULTS}{transmission_network}/{case_name}/figures/dispatch/gas_dispatch.png",
                f"{RESULTS}{transmission_network}/{case_name}/figures/dispatch/hydrogen_dispatch.png",
                f"{RESULTS}{transmission_network}/{case_name}/figures/dispatch/storage_soc.png",
            ]
        )

        # Network maps
        outputs.extend(
            [
                f"{RESULTS}{transmission_network}/{case_name}/figures/maps/elec_cap_network.png",
                f"{RESULTS}{transmission_network}/{case_name}/figures/maps/gas_cap_network.png",
                f"{RESULTS}{transmission_network}/{case_name}/figures/maps/h2_cap_network.png",
                f"{RESULTS}{transmission_network}/{case_name}/figures/maps/large_storage_cap_network.png",
                f"{RESULTS}{transmission_network}/{case_name}/figures/maps/small_storage_cap_network.png",
                f"{RESULTS}{transmission_network}/{case_name}/figures/maps/demand_cap_network.png",
            ]
        )

        # Cost figures
        outputs.append(
            f"{RESULTS}{transmission_network}/{case_name}/figures/cost/system_costs.png"
        )
        outputs.append(
            f"{RESULTS}{transmission_network}/{case_name}/figures/cost/lmps.png"
        )

        # Flexibility figures
        outputs.extend(
            [
                # Week-based flexibility
                f"{RESULTS}{transmission_network}/{case_name}/figures/flexibility/flexibility_contribution_Interconnection_week.png",
                # Month-based flexibility
                f"{RESULTS}{transmission_network}/{case_name}/figures/flexibility/flexibility_contribution_Interconnection_month.png",
                # Season-based flexibility
                f"{RESULTS}{transmission_network}/{case_name}/figures/flexibility/flexibility_contribution_Interconnection_season.png",
            ]
        )

    return outputs


rule all:
    input:
        get_all_outputs,
    default_target: True


# ======================== Utility Rules ========================
# Create DAG with-
# snakemake --dag > dag.dot
# dot -Tpng dag.dot -o dag.png
rule dag:
    message:
        "Creating DAG of workflow."
    output:
        dot="repo_data/dag.dot",
        jpg="repo_data/dag.jpg",
    shell:
        """
        snakemake --rulegraph all | sed -n "/digraph/,\$p" > {output.dot}
        dot -Tjpg -o {output.jpg} {output.dot}
        """


rule clean:
    message:
        "Remove all build results but keep downloaded data."
    run:
        import shutil

        shutil.rmtree("resources", ignore_errors=True)
        shutil.rmtree("results", ignore_errors=True)
        shutil.rmtree("logs", ignore_errors=True)
        print("Data downloaded to data/ has not been cleaned.")


# ======================== Case-specific Target Rules ========================
rule run_case:
    """
    Run a specific case completely.
    Usage: snakemake --cores 1 run_case --config case=E+
    """
    input:
        lambda w: [
            f"{RESULTS}{config['cases'][w.case].get('model_topology', {}).get('transmission_network', config.get('model_topology', {}).get('transmission_network', 'tamu'))}/{w.case}/figures/capacity/generation_capacities.png",
            f"{RESULTS}{config['cases'][w.case].get('model_topology', {}).get('transmission_network', config.get('model_topology', {}).get('transmission_network', 'tamu'))}/{w.case}/figures/dispatch/electricity_dispatch.png",
            f"{RESULTS}{config['cases'][w.case].get('model_topology', {}).get('transmission_network', config.get('model_topology', {}).get('transmission_network', 'tamu'))}/{w.case}/figures/maps/elec_cap_network.png",
            f"{RESULTS}{config['cases'][w.case].get('model_topology', {}).get('transmission_network', config.get('model_topology', {}).get('transmission_network', 'tamu'))}/{w.case}/figures/cost/system_costs.png",
        ],
    message:
        "Completed case: {wildcards.case}"
