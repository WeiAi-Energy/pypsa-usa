# ----------------------------------- Rules ---------------------------------- #


def iter_case_configs():
    if CASES_ENABLED:
        for case_name in CASES:
            yield case_name, case_config(case_name)
    else:
        yield CASES[0], config


def expand_case_targets(pattern, **kwargs):
    targets = []
    for case_name, cfg in iter_case_configs():
        targets.extend(expand_case_targets_for(case_name, cfg, pattern, **kwargs))
    return targets


def expand_case_targets_for(case_name, cfg, pattern, **kwargs):
    expand_kwargs = dict(cfg["scenario"])
    if CASES_ENABLED:
        expand_kwargs["case"] = [case_name]
    expand_kwargs.update(kwargs)
    return expand(pattern, **expand_kwargs)


def electricity_figures(wildcards):
    figs = []
    for case_name, cfg in iter_case_configs():
        figs.append(
            expand_case_targets_for(
                case_name,
                cfg,
                result_figure_path("maps"),
                figure=FIGURES_MAPS,
            )
        )
        figs.append(
            expand_case_targets_for(
                case_name,
                cfg,
                result_figure_path("statistics"),
                figure=STATISTICS_TABLES,
            )
        )
    return list(chain(*figs))


rule all:
    input:
        #"repo_data/dag.jpg",
        electricity_figures,


rule data_model:
    input:
        expand_case_targets(
            CASE_RESOURCES
            + "elec_ec_l{ll}_{opts}.nc",
        ),


# Create DAG with-
# snakemake --rulegraph all | sed -n "/digraph/,\$p" | dot -Tpng -o repo_data/dag.jpg
# snakemake --dag -F | sed -n "/digraph/,\$p" | dot -Tpng -o repo_data/dag.jpg
rule dag:
    message:
        "Creating DAG of workflow."
    output:
        dot="repo_data/dag.dot",
        jpg="repo_data/dag.jpg",
    shell:
        """
        snakemake --rulegraph all | sed -n "/digraph/,\$p" > {output.dot}
        dot -Tjpg -o {output.jpg} {output.dot}
        """


rule clean:
    message:
        "Remove all build results but keep downloaded data."
    run:
        import shutil

        shutil.rmtree("resources", ignore_errors=True)
        shutil.rmtree("results", ignore_errors=True)
        print("Data downloaded to data/ has not been cleaned.")
