FIGURE_ROOT = CASE_RESULTS + "figure/"
def result_network_path(suffix=""):
    return CASE_RESULTS + "network/network" + suffix + ".nc"


def result_config_path():
    return CASE_RESULTS + "config/config.yaml"


def result_figure_path(*parts, figure="{figure}"):
    return FIGURE_ROOT + "/".join(parts) + "/" + figure


